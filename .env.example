# ─────────────────────────────────────────────────────────────────
# AI Dashboard — Environment Configuration
# Copy this to .env and fill in your values
# ─────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# ── Kafka (REQUIRED) ──────────────────────────────────────────────
# Comma-separated list of broker host:port pairs
KAFKA_BROKERS=your-kafka-host:9092
# Comma-separated list of topics to subscribe to
KAFKA_TOPICS=ai-workflow-events
KAFKA_GROUP_ID=ai-dashboard-group
KAFKA_CLIENT_ID=ai-dashboard

# SASL (optional — comment out if not using auth)
# KAFKA_SASL_MECHANISM=plain          # plain | scram-sha-256 | scram-sha-512
# KAFKA_SASL_USERNAME=your-username
# KAFKA_SASL_PASSWORD=your-password
# KAFKA_SSL=false                     # set to true if using TLS

# ── MongoDB (OPTIONAL) ────────────────────────────────────────────
# Leave blank to disable MongoDB historical lookup
# MONGO_URI=mongodb://your-mongo-host:27017
# MONGO_DB_NAME=ai_workflows
# MONGO_COLLECTION_EVENTS=workflow_events

# ── In-Memory State ───────────────────────────────────────────────
STATE_MAX_WORKFLOWS=10000    # max workflows to hold in memory
STATE_TTL_MINUTES=60         # evict workflows older than N minutes

# ── Frontend (Next.js) ────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=http://localhost:4000
