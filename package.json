{
    "name": "ai-dashboard",
    "version": "1.0.0",
    "private": true,
    "packageManager": "pnpm@11.0.9",
    "engines": {
        "node": ">=20.0.0",
        "pnpm": ">=9.0.0"
    },
    "scripts": {
        "dev": "turbo dev",
        "build": "turbo build",
        "lint": "turbo lint",
        "test": "turbo test",
        "type-check": "turbo type-check",
        "simulate": "node scripts/simulate-events.mjs",
        "simulate:once": "node scripts/simulate-events.mjs --once",
        "simulate:fast": "node scripts/simulate-events.mjs --speed 3",
        "simulate:kafka": "node scripts/kafka-producer.mjs",
        "simulate:kafka:once": "node scripts/kafka-producer.mjs --once",
        "format": "prettier --write \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore"
    },
    "devDependencies": {
        "turbo": "^2.3.3",
        "prettier": "^3.3.3",
        "typescript": "^5.6.3",
        "kafkajs": "^2.2.4"
    }
}